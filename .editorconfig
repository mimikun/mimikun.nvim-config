root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 4

[*.{lua}]
indent_size = 2

[*.{sh,fish,zsh}]
indent_size = 2

[*.{yaml,yml}]
indent_size = 2

[*.{json}]
indent_size = 2

[*.{toml}]
indent_size = 2

[*.{ts}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{ps1,psd1}]
charset = utf-8-bom
end_of_line = crlf
